# Credentials and database identity. Copy to `secrets.env` (gitignored).
#
# The opposite of `.env` on both counts that matter: **none of this is
# expected to change**, and all of it must be restored *verbatim*. Change
# `SECRET_KEY` and every session and password-reset token in flight is void;
# change the database name or the application role and the site can no longer
# reach its own data.
#
# So back this file up as a unit and put it back untouched. `.env` is the
# file you edit when moving hosts; this one you do not.
#
# Nothing here is interpolated into compose.yaml: these reach the containers
# through `env_file:`, so the committed compose file never refers to a
# credential. (`podman compose config` expands env_file contents into what it
# prints -- its output is as sensitive as this file.)
#
# The values below are working lab defaults, so the suite comes up with no
# editing. They are lab credentials: do not reuse them anywhere real.
#
# One character to avoid when choosing a value by hand: **`$`**. Compose
# expands variables in the values it reads from this file, so a password
# containing `$HOME` or `${SITE_NAME}` arrives at the container as something
# else entirely, and the site simply fails to authenticate with no indication
# why. Measured -- it is not a theoretical hazard, and it applies to `.env`
# equally. `scripts/configure-host.py` generates from [A-Za-z0-9_-] for this
# reason, among others.

# ---------------------------------------------------------------------------
# Flask. Signs sessions and the tokens in password-reset and confirmation
# links, so replacing it silently invalidates every one of them.
# ---------------------------------------------------------------------------
SECRET_KEY=lab-only-secret-key

# ---------------------------------------------------------------------------
# The key flask-security derives its password hashes from. "Salt" is its name
# for it; it behaves as an HMAC key, and **changing it makes every stored
# password unverifiable**. There is no way back from that but a password reset
# for every account, so restore it verbatim with the rest of this file.
#
# Required -- podpack refuses to boot without it -- and deliberately not
# defaulted, because a value shipped in the framework would make one site's
# password hashes verifiable against another's.
#
# Generate one per site, once:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
# ---------------------------------------------------------------------------
SECURITY_PASSWORD_SALT=lab-only-password-salt
