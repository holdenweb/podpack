# Credentials and database identity. Copy to `secrets.env` (gitignored).
#
# The opposite of `.env` on both counts that matter: **none of this is expected
# to change**, and all of it must be restored *verbatim*. Change `SECRET_KEY`
# and every session and password-reset token in flight is void; change the
# database name or the application role and the site can no longer reach its
# own data.
#
# So back this up as a unit and put it back untouched. `.env` is the file you
# edit when moving hosts; this one you do not.
#
# Nothing here is interpolated into compose.yaml: these reach the containers
# through `env_file:`, so the committed compose file never refers to a
# credential and stays safe to read.
#
# `podman compose config` is the exception, and worth knowing about -- it
# expands env_file contents into the environment it prints. Its output is as
# sensitive as this file.
#
# The values below are working lab defaults, so the suite comes up with no
# editing. They are lab credentials: do not reuse them anywhere real.

# ---------------------------------------------------------------------------
# The database, as one unit. The name, the roles and the URI all have to agree
# with the cluster on disk, which is why they live together rather than being
# assembled from parts that could drift apart.
#
# POSTGRES_USER / POSTGRES_PASSWORD are the superuser credentials, and are the
# names the postgres image itself reads. They are used exactly once, by the
# first-run bootstrap in db-init/, to create the far less privileged role the
# application actually connects as. The application is never given them.
# ---------------------------------------------------------------------------
POSTGRES_USER=labadmin
POSTGRES_PASSWORD=labadmin-password
POSTGRES_DB=holdenweb

POSTGRES_APP_USER=holdenweb_app
POSTGRES_APP_PASSWORD=holdenweb-app-password

# The application's connection string. `postgres` is the service name on the
# compose network and 5432 its internal port, so this is the same on every host
# -- what varies is the password it carries, which is why it belongs here.
SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://holdenweb_app:holdenweb-app-password@postgres:5432/holdenweb

# ---------------------------------------------------------------------------
# Flask. Signs sessions and the tokens in password-reset and confirmation
# links, so replacing it silently invalidates every one of them.
# ---------------------------------------------------------------------------
SECRET_KEY=lab-only-secret-key
