# Running this site locally, without containers. Copy to `dev.env`, which is
# gitignored, and edit. `scripts/dev.sh` makes that copy for you on first run.
#
# The counterpart of `.env`, and deliberately not part of it: `.env` is
# compose's, read for substitution and mounted into containers, and a local
# run that borrowed it would be one edit away from pointing development at
# production's database.
#
# These are the variables podpack itself requires. It supplies no defaults
# for the first two on purpose -- a framework that defaults a secret is a
# framework that lets a real deployment boot with a lab value -- so they live
# here, in a file you can see, rather than in code you would have to read.

# ---------------------------------------------------------------------------
# A local PostgreSQL, not SQLite.
#
# SQLite is tempting and costs more than it saves: `alembic revision
# --autogenerate` run against it produces revisions PostgreSQL may reject --
# `ALTER COLUMN` is PostgreSQL-only syntax, and a baseline written that way
# was fatal on SQLite in this project's own history. Authoring against the
# engine you deploy on is the whole point of authoring on the host (ADR-0011).
#
# Expects a natively installed server on the default port. Create the role and
# database once:
#
#     createuser --pwprompt podpack_app
#     createdb --owner podpack_app podpack
#
# `scripts/dev.sh` prints these again if it cannot connect. It will not run
# them for you: creating a database on a server podpack does not own is not
# something a run script should do behind your back.
# ---------------------------------------------------------------------------
SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://podpack_app:@@DB_PASSWORD@@@127.0.0.1:5432/podpack

# ---------------------------------------------------------------------------
# Signs sessions and the tokens in password-reset links. A throwaway value is
# right here and wrong anywhere else; the deployed site's lives in
# secrets.env, which podpack never writes.
# ---------------------------------------------------------------------------
SECRET_KEY=dev-only-not-a-real-secret

# ---------------------------------------------------------------------------
# The same config file the containers mount, so a local run installs the same
# apps, in the same order, with the same settings. That is what makes "it
# works locally" mean anything.
# ---------------------------------------------------------------------------
PODPACK_CONFIG=config/app.toml

# ---------------------------------------------------------------------------
# Separate from the container roots under hostdata/, because those are owned
# by the uid the containers drop to and a local process writing there leaves
# files the containers cannot read. Same layout, different tree.
# ---------------------------------------------------------------------------
PODPACK_DATA_ROOT=./devdata/apps
PODPACK_LOG_ROOT=./devlogs/apps

# ---------------------------------------------------------------------------
# The development server's port. 5000 is AirPlay Receiver on macOS, and the
# symptom of that clash is 403s that look like an application bug.
# ---------------------------------------------------------------------------
FLASK_RUN_PORT=5001
