# Per-host deployment settings. Copy to `.env` (gitignored) and adjust.
#
# Everything here is **expected to differ between hosts** and is meant to be
# edited when you stand the site up somewhere new. Nothing here is a secret, and
# nothing here has to survive a restore unchanged.
#
# Its counterpart is `secrets.env`, which is the opposite on both counts: every
# value there must be restored *verbatim* or the site loses access to its own
# data. Keeping them apart is what makes restoring to a new host a matter of
# putting one file back and editing the other, rather than hand-editing a copy
# of a backup that mixes the two.
#
# This is also the only file compose reads for substitution, which is why no
# credential appears in it: secrets are handed to containers through
# `env_file:` and never interpolated into compose.yaml.
#
# (`podman compose config` still prints them, since it expands env_file
# contents -- treat its output as sensitive.)

# ---------------------------------------------------------------------------
# What this deployment is called.
#
# Names the compose project and the image, so two sites on one host cannot
# collide and `podman ps` says which is which. Keep it in step with `name` in
# config/app.toml -- compose cannot read TOML, which is the only reason the
# site's name is written twice.
# ---------------------------------------------------------------------------
SITE_NAME=holdenweb-lab

# ---------------------------------------------------------------------------
# Host paths. Relative paths are resolved against this directory; absolute
# paths are what you would use on a real host, e.g.
#   HOST_DATA_DIR=/srv/holdenweb/data
#   HOST_LOG_DIR=/var/log/holdenweb
#
# On Opalstack these live under the proxy-port application's directory,
# ~/apps/<app-name>/.
# ---------------------------------------------------------------------------
HOST_DATA_DIR=./hostdata
HOST_LOG_DIR=./hostlogs

# ---------------------------------------------------------------------------
# Ports published on the host.
#
# Offset from both the real site (8456) and a natively installed PostgreSQL
# (5432), and from the MongoDB lab (8457/27018), so all of them can run at
# once and none can be mistaken for another.
#
# WEB_HOST_PORT is the site's external port, and the one setting a managed host
# is likely to dictate: an Opalstack "Nginx Proxy Port" application is given a
# port and its site is proxied there, so deploying is a matter of putting that
# number here. See the README's Opalstack section.
#
# WEB_BIND_ADDR defaults to loopback, which is right for a lab and for any host
# whose own proxy runs beside the container. Widen it only if something off the
# machine has to reach the port directly.
# ---------------------------------------------------------------------------
WEB_HOST_PORT=8458
WEB_BIND_ADDR=127.0.0.1
POSTGRES_HOST_PORT=5433

# ---------------------------------------------------------------------------
# Tuning.
# ---------------------------------------------------------------------------
GUNICORN_WORKERS=2

# --- added by podpack substrate upgrade (podpack 0.3.0) ---
# ---------------------------------------------------------------------------
# Which backing services this site runs.
#
# compose.yaml is the base -- the site, its storage and the migration gate --
# and every backing service is an overlay beside it. This line is the only
# language compose speaks; `[site] services` in config/app.toml is the same
# statement in podpack's, and the two are checked against each other at boot.
# Keep them in step, exactly as SITE_NAME and `name` are kept in step, and for
# the same reason: compose cannot read TOML.
#
# `podpack substrate status` prints the line this site needs.
# ---------------------------------------------------------------------------
COMPOSE_FILE=compose.yaml:compose.postgres.yaml

# --- added by podpack substrate upgrade (podpack 0.3.0) ---
POSTGRES_BIND_ADDR=127.0.0.1
