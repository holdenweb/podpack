# Copy to `.env` (gitignored) and adjust. This is the ONLY file that should
# differ between your laptop and a real host -- everything else in this
# directory is meant to be deployed verbatim.
#
# The values below are deliberately working defaults so the lab comes up with
# no editing. They are lab credentials: do not reuse them anywhere real.

# ---------------------------------------------------------------------------
# Host paths. Relative paths are resolved against this directory; absolute
# paths are what you would use on a real host, e.g.
#   HOST_DATA_DIR=/srv/holdenweb/data
#   HOST_LOG_DIR=/var/log/holdenweb
# ---------------------------------------------------------------------------
HOST_DATA_DIR=./hostdata
HOST_LOG_DIR=./hostlogs

# ---------------------------------------------------------------------------
# Ports published on the host.
#
# Offset from both the real site (8456) and a natively installed PostgreSQL
# (5432), and from the MongoDB lab (8457/27018), so all of them can run at
# once and none can be mistaken for another.
#
# WEB_HOST_PORT is the site's external port, and the one setting a managed host
# is likely to dictate: an Opalstack "Nginx Proxy Port" application is given a
# port and its site is proxied there, so deploying is a matter of putting that
# number here. See the README's Opalstack section.
#
# WEB_BIND_ADDR defaults to loopback, which is right for a lab and for any host
# whose own proxy runs beside the container. Widen it only if something off the
# machine has to reach the port directly.
# ---------------------------------------------------------------------------
WEB_HOST_PORT=8458
WEB_BIND_ADDR=127.0.0.1
POSTGRES_HOST_PORT=5433

# ---------------------------------------------------------------------------
# PostgreSQL. The admin credentials are used once, by the image's first-run
# bootstrap, to create the far less privileged application role that Flask
# actually connects with.
# ---------------------------------------------------------------------------
POSTGRES_ADMIN_USER=labadmin
POSTGRES_ADMIN_PASSWORD=labadmin-password
POSTGRES_DB=holdenweb
POSTGRES_APP_USER=holdenweb_app
POSTGRES_APP_PASSWORD=holdenweb-app-password

# ---------------------------------------------------------------------------
# Flask.
# ---------------------------------------------------------------------------
SECRET_KEY=lab-only-secret-key
GUNICORN_WORKERS=2
