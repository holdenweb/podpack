# --- mongodb ----------------------------------------------------------------
# MongoDB publishes nothing by default; these are the on-request forwarder's
# settings (ADR-0027):
#
#     podman compose --profile mongodb-port up -d mongodb-port
#     MONGODB_HOST_PORT=27020 podman compose --profile mongodb-port up -d mongodb-port
#
# 27019 rather than 27017, which is very likely a natively installed mongod,
# or 27018, which the MongoDB lab this service grew out of used.
MONGODB_HOST_PORT=@@MONGODB_HOST_PORT@@
MONGODB_BIND_ADDR=127.0.0.1
