# --- mongodb ----------------------------------------------------------------
# The root credentials are the names the mongo image itself reads. They are
# used exactly once, by the first-run bootstrap in mongodb-init/, to create
# the far less privileged user the application connects as -- which is never
# given them.
MONGO_INITDB_ROOT_USERNAME=labadmin
MONGO_INITDB_ROOT_PASSWORD=labadmin-password
MONGODB_DB=@@DB_NAME@@

MONGODB_APP_USER=@@DB_USER@@
MONGODB_APP_PASSWORD=@@DB_PASSWORD@@

# The application's connection string, whole rather than assembled, exactly
# as its SQLAlchemy sibling is: `mongodb` is the service name on the compose
# network and 27017 its internal port, so only the password varies by host.
MONGODB_URI=mongodb://@@DB_USER@@:@@DB_PASSWORD@@@mongodb:27017/@@DB_NAME@@
