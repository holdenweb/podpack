# --- postgres ---------------------------------------------------------------
# The database publishes nothing by default; these are the on-request
# forwarder's settings (ADR-0027):
#
#     podman compose --profile postgres-port up -d postgres-port
#     POSTGRES_HOST_PORT=5439 podman compose --profile postgres-port up -d postgres-port
#
# A shell variable beats this file, so a number can be chosen per use without
# editing anything. Nothing inside the suite reads either of them.
POSTGRES_HOST_PORT=@@POSTGRES_HOST_PORT@@
POSTGRES_BIND_ADDR=127.0.0.1
