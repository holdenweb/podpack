# --- postgres ---------------------------------------------------------------
# The database, as one unit. The name, the roles and the URI all have to agree
# with the cluster on disk, which is why they live together rather than being
# assembled from parts that could drift apart.
#
# POSTGRES_USER / POSTGRES_PASSWORD are the superuser credentials, and are the
# names the postgres image itself reads. They are used exactly once, by the
# first-run bootstrap in db-init/, to create the far less privileged role the
# application actually connects as. The application is never given them.
POSTGRES_USER=labadmin
POSTGRES_PASSWORD=labadmin-password
POSTGRES_DB=@@DB_NAME@@

POSTGRES_APP_USER=@@DB_USER@@
POSTGRES_APP_PASSWORD=@@DB_PASSWORD@@

# The application's connection string. `postgres` is the service name on the
# compose network and 5432 its internal port, so this is the same on every host
# -- what varies is the password it carries, which is why it belongs here.
SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://@@DB_USER@@:@@DB_PASSWORD@@@postgres:5432/@@DB_NAME@@
