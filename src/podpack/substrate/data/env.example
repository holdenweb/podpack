# Per-host deployment settings. Copy to `.env` (gitignored) and adjust.
#
# Everything here is **expected to differ between hosts** and is meant to be
# edited when you stand the site up somewhere new. Nothing here is a secret,
# and nothing here has to survive a restore unchanged.
#
# Its counterpart is `secrets.env`, which is the opposite on both counts:
# every value there must be restored *verbatim* or the site loses access to
# its own data. Keeping them apart is what makes restoring to a new host a
# matter of putting one file back and editing the other.
#
# This is the only file compose reads for substitution, which is why no
# credential appears in it: secrets reach containers through `env_file:` and
# are never interpolated into compose.yaml. (`podman compose config` still
# prints them, since it expands env_file contents -- treat its output as
# sensitive.)

# ---------------------------------------------------------------------------
# What this deployment is called.
#
# Names the compose project and the image, so two sites on one host cannot
# collide and `podman ps` says which is which. Keep it in step with `name` in
# config/app.toml -- compose cannot read TOML, which is the only reason the
# site's name is written twice.
# ---------------------------------------------------------------------------
SITE_NAME=@@SITE_NAME@@

# ---------------------------------------------------------------------------
# Host paths. Relative paths are resolved against this directory; absolute
# paths are what you would use on a real host, e.g.
#   HOST_DATA_DIR=/srv/mysite/data
#   HOST_LOG_DIR=/var/log/mysite
#
# On Opalstack these live under the proxy-port application's directory,
# ~/apps/<app-name>/.
# ---------------------------------------------------------------------------
HOST_DATA_DIR=./hostdata
HOST_LOG_DIR=./hostlogs

# ---------------------------------------------------------------------------
# Ports published on the host.
#
# WEB_HOST_PORT is the site's external port, and the one setting a managed
# host is likely to dictate: an Opalstack "Nginx Proxy Port" application is
# given a port and its site is proxied there, so deploying is a matter of
# putting that number here. Pick one that clashes with nothing already
# running: a clash fails at container start with "address already in use",
# and nothing warns beforehand.
#
# WEB_BIND_ADDR defaults to loopback, which is right for a lab and for any
# host whose own proxy runs beside the container. Widen it only if something
# off the machine has to reach the port directly.
#
# The database publishes nothing by default, so POSTGRES_HOST_PORT is only a
# default for the on-request forwarder:
#
#     podman compose --profile dbport up -d dbport
#     POSTGRES_HOST_PORT=5439 podman compose --profile dbport up -d dbport
#
# A shell variable beats this file, so the number can be chosen per use
# without editing anything. Nothing inside the suite reads it.
# ---------------------------------------------------------------------------
WEB_HOST_PORT=@@WEB_HOST_PORT@@
WEB_BIND_ADDR=127.0.0.1
POSTGRES_HOST_PORT=@@POSTGRES_HOST_PORT@@

# ---------------------------------------------------------------------------
# Tuning.
# ---------------------------------------------------------------------------
GUNICORN_WORKERS=2
