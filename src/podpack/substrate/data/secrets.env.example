# Credentials and database identity. Copy to `secrets.env` (gitignored).
#
# The opposite of `.env` on both counts that matter: **none of this is
# expected to change**, and all of it must be restored *verbatim*. Change
# `SECRET_KEY` and every session and password-reset token in flight is void;
# change the database name or the application role and the site can no longer
# reach its own data.
#
# So back this file up as a unit and put it back untouched. `.env` is the
# file you edit when moving hosts; this one you do not.
#
# Nothing here is interpolated into compose.yaml: these reach the containers
# through `env_file:`, so the committed compose file never refers to a
# credential. (`podman compose config` expands env_file contents into what it
# prints -- its output is as sensitive as this file.)
#
# The values below are working lab defaults, so the suite comes up with no
# editing. They are lab credentials: do not reuse them anywhere real.

# ---------------------------------------------------------------------------
# The database, as one unit. The name, the roles and the URI all have to
# agree with the cluster on disk, which is why they live together rather than
# being assembled from parts that could drift apart.
#
# POSTGRES_USER / POSTGRES_PASSWORD are the superuser credentials, and are
# the names the postgres image itself reads. They are used exactly once, by
# the first-run bootstrap in db-init/, to create the far less privileged role
# the application actually connects as. The application is never given them.
# ---------------------------------------------------------------------------
POSTGRES_USER=labadmin
POSTGRES_PASSWORD=labadmin-password
POSTGRES_DB=@@DB_NAME@@

POSTGRES_APP_USER=@@DB_USER@@
POSTGRES_APP_PASSWORD=@@DB_PASSWORD@@

# The application's connection string. `postgres` is the service name on the
# compose network and 5432 its internal port, so this is the same on every
# host -- what varies is the password it carries, which is why it belongs
# here.
SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://@@DB_USER@@:@@DB_PASSWORD@@@postgres:5432/@@DB_NAME@@

# ---------------------------------------------------------------------------
# Flask. Signs sessions and the tokens in password-reset and confirmation
# links, so replacing it silently invalidates every one of them.
# ---------------------------------------------------------------------------
SECRET_KEY=lab-only-secret-key
